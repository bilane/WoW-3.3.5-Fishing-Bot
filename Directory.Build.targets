<Project>
  <PropertyGroup Condition="'$(TargetFrameworkVersion)' == 'v4.0'">
    <TargetFrameworkRootPath>$(MSBuildThisFileDirectory)packages\Microsoft.NETFramework.ReferenceAssemblies.net40.1.0.3\build\</TargetFrameworkRootPath>
    <FrameworkPathOverride>$(MSBuildThisFileDirectory)packages\Microsoft.NETFramework.ReferenceAssemblies.net40.1.0.3\build\.NETFramework\v4.0</FrameworkPathOverride>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFrameworkVersion)' == 'v4.7.2'">
    <TargetFrameworkRootPath>$(MSBuildThisFileDirectory)packages\Microsoft.NETFramework.ReferenceAssemblies.net472.1.0.3\build\</TargetFrameworkRootPath>
    <FrameworkPathOverride>$(MSBuildThisFileDirectory)packages\Microsoft.NETFramework.ReferenceAssemblies.net472.1.0.3\build\.NETFramework\v4.7.2</FrameworkPathOverride>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'GreyMagic'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <Target Name="BuildFasmManagedDependency" BeforeTargets="ResolveReferences" Condition="'$(MSBuildProjectName)' == 'GreyMagic'">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)BuildDependencies\FASM.OBJ"
          DestinationFiles="$(MSBuildThisFileDirectory)GreyMagic\fasmdll_managed\FASM.OBJ" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)GreyMagic\fasmdll_managed\fasmdll_managed.vcxproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=Win32;ForceImportAfterCppTargets=$(MSBuildThisFileDirectory)BuildDependencies\FasmLinker.targets" />
    <ItemGroup>
      <Reference Include="fasmdll_managed">
        <HintPath>$(MSBuildThisFileDirectory)GreyMagic\fasmdll_managed\bin\$(Configuration)\fasmdll_managed.dll</HintPath>
        <Private>True</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
